<% default_category_name = Category.find_by(id: Category::NO_CATEGORY_ID)&.category_name %>

<div class="doc-header">
  <div class="kicker">Rezultate · <%= @competition.distance_type %></div>
  <h1 class="title"><%= @competition.competition_name %></h1>
  <div class="meta">
    <span><%= @competition.date&.strftime("%d.%m.%Y") %></span>
    <% if @competition.location.present? %><span><%= @competition.location %></span><% end %>
    <% if @competition.country.present? %><span><%= @competition.country %></span><% end %>
  </div>
  <div class="tags">
    <% if @competition.ecn %><span class="tag">ECN</span><% end %>
    <% if @competition.wre_id %><span class="tag">WRE #<%= @competition.wre_id %></span><% end %>
  </div>
</div>

<% @pdf_groups.each do |group| %>
  <% if @competition.relay? %>
    <% relays = @pdf_relay_results_by_group_id[group.id] || [] %>
    <% next if relays.empty? %>
    <div class="group">
      <div class="group-head">
        <h2 class="name"><%= group.group_name %></h2>
        <div class="sub">
          <% if group.rang %>R: <span class="mono"><%= group.rang.to_i %></span><% end %>
          · <%= relays.size %> echipe
        </div>
      </div>

      <% relays.each do |relay| %>
        <div class="relay-section">
          <div class="relay-bar">
            <div class="pl"><%= relay.place %></div>
            <div>
              <div class="team"><%= relay.team %></div>
              <div class="meta">Cat. îndeplinită: <%= relay.category&.category_name || default_category_name %></div>
            </div>
            <div class="total"><%= Time.at(relay.time.to_i).utc.strftime('%H:%M:%S') if relay.time %></div>
          </div>

          <table>
            <thead>
              <tr>
                <th style="width: 30px;">#</th>
                <th>Sportiv</th>
                <th>Club</th>
                <th style="width: 50px;">An</th>
                <th style="width: 60px; text-align: right;">Etapă</th>
                <th style="width: 60px; text-align: right;">Cumulat</th>
              </tr>
            </thead>
            <tbody>
              <% cumulative = 0 %>
              <% (relay.results_id || []).each_with_index do |leg_id, i| %>
                <% leg = @pdf_legs_by_id[leg_id] %>
                <% next unless leg %>
                <% cumulative += leg.time.to_i %>
                <tr>
                  <td class="place"><%= i + 1 %></td>
                  <td><%= "#{leg.membership&.runner&.runner_name} #{leg.membership&.runner&.surname}" %></td>
                  <td><%= leg.membership&.club&.club_name %></td>
                  <td class="t"><%= leg.membership&.runner&.yob %></td>
                  <td class="t" style="text-align: right;"><%= Time.at(leg.time.to_i).utc.strftime('%H:%M:%S') if leg.time %></td>
                  <td class="t" style="text-align: right;"><%= Time.at(cumulative).utc.strftime('%H:%M:%S') %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <% if group.rang %>
        <% percent_and_time_data = RelayGroupCategoriesProcessor.new(group).get_percent_and_times %>
        <% if percent_and_time_data.any? %>
          <div class="stats">
            <div class="title">Procente pe categorii · Rang <span class="mono"><%= group.rang.to_i %></span><% if group.clasa.present? %> · Cl <%= (Category.find_by(id: group.clasa.to_i)&.category_name if group.clasa.to_s[/\d{1,2}/]) || group.clasa %><% end %></div>
            <table>
              <thead>
                <tr><th>Categoria</th><th>%</th><th style="text-align: right;">Timp</th></tr>
              </thead>
              <tbody>
                <% percent_and_time_data.each do |cat| %>
                  <tr>
                    <td><%= cat[:category] %></td>
                    <td class="t"><%= cat[:percent] %></td>
                    <td class="t" style="text-align: right;"><%= cat[:time] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <% results = group.results.sort_by { |r| r.place.to_i.zero? ? Float::INFINITY : r.place.to_i } %>
    <div class="group">
      <div class="group-head">
        <h2 class="name"><%= group.group_name %></h2>
        <div class="sub">
          <% if group.rang %>R: <span class="mono"><%= group.rang.to_i %></span><% end %>
          <% if group.clasa.present? %>
            · Cl: <%= (Category.find_by(id: group.clasa.to_i)&.category_name if group.clasa.to_s[/\d{1,2}/]) || group.clasa %>
          <% end %>
          · <%= results.size %> sportivi
        </div>
      </div>

      <table>
        <thead>
          <tr>
            <th style="width: 28px;">#</th>
            <th>Sportiv</th>
            <th>Club</th>
            <th style="width: 40px;">An</th>
            <th>Cat. act.</th>
            <th style="width: 60px; text-align: right;">Timp</th>
            <th>Cat. îndepl.</th>
            <% if @competition.ecn %><th style="width: 40px; text-align: right;">ECN</th><% end %>
          </tr>
        </thead>
        <tbody>
          <% results.each do |result| %>
            <% runner = result.membership&.runner %>
            <% actual = @runner_actual_category_name_by_result_id[result.id] || default_category_name %>
            <% pclass = result.place == 1 ? "p1" : (result.place == 2 ? "p2" : (result.place == 3 ? "p3" : "")) %>
            <tr>
              <td class="place <%= pclass %>"><%= result.place %></td>
              <td><%= "#{runner&.runner_name} #{runner&.surname}" %></td>
              <td><%= result.membership&.club&.club_name %></td>
              <td class="t"><%= runner&.yob %></td>
              <% if result.status == Result::CAPPED %>
                <td><%= actual %> (<%= result.child_results.first&.category&.category_name %>*)</td>
              <% else %>
                <td><%= actual %></td>
              <% end %>
              <td class="t" style="text-align: right;"><%= Time.at(result.time.to_i).utc.strftime('%H:%M:%S') if result.time %></td>
              <td><%= result.category&.category_name %></td>
              <% if @competition.ecn %><td class="t" style="text-align: right;"><%= result.ecn_points %></td><% end %>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if results.any? { |r| r.status == Result::CAPPED } %>
        <p class="footnote">* Categoria trebuie confirmată la Ministerul Educației și Cercetării al Republicii Moldova</p>
      <% end %>

      <% if group.rang %>
        <% percent_and_time_data = GroupCategoriesProcessor.new(group).get_percent_and_times %>
        <% if percent_and_time_data.any? %>
          <div class="stats">
            <div class="title">Procente pe categorii · Rang <span class="mono"><%= group.rang.to_i %></span></div>
            <table>
              <thead>
                <tr><th>Categoria</th><th>%</th><th style="text-align: right;">Timp</th></tr>
              </thead>
              <tbody>
                <% percent_and_time_data.each do |cat| %>
                  <tr>
                    <td><%= cat[:category] %></td>
                    <td class="t"><%= cat[:percent] %></td>
                    <td class="t" style="text-align: right;"><%= cat[:time] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
