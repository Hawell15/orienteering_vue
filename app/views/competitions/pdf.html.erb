<% default_category_name = Category.find_by(id: Category::NO_CATEGORY_ID)&.category_name %>
<div>
    <% @pdf_groups.each do |group| %>
    <% if @competition.relay? %>
        <% relays = @pdf_relay_results_by_group_id[group.id] || [] %>
        <% next if relays.empty? %>
        <% first_leg = (@pdf_legs_by_id[relays.first.results_id&.first] if relays.first.results_id) %>
        <% group_class_name = first_leg&.membership&.runner&.gender == "W" ? "women" : "men" %>
        <div class="group">
            <header>
                <div class="logo">
                    <%= image_tag "#{request.protocol}#{request.host_with_port}#{vite_asset_path('images/logo_fos.png')}",
                                      alt: "Competition Logo",
                                      height: "80" %>
                </div>
                <div class="title-block">
                    <h1><%= @competition.competition_name %></h1>
                    <h2><%= @competition.location %> <%= @competition.date&.strftime("%d/%m/%Y") %></h2>
                    <h2><%= @competition.distance_type %></h2>
                </div>
            </header>
            <h3 class="<%= group_class_name %>">
                <%= group.group_name %>
            </h3>
            <table>
                <thead>
                    <tr style="background-color: #90EE90;">
                        <th>Locul</th>
                        <th colspan="2">Echipa</th>
                        <th colspan="2">Timpul</th>
                        <th>Categoria îndeplinită</th>
                    </tr>
                </thead>
                <tbody>
                    <% relays.each do |relay| %>
                        <% place_color = case relay.place
                                                when 1 then "#FFDF00"
                                                when 2 then "#D7D7D8"
                                                when 3 then "#CE8946"
                                                else "#80bfff"
                                                end %>
                        <tr style="background-color: #80bfff;">
                            <td style="background-color: <%= place_color %>;"><%= relay.place %></td>
                            <td colspan="2"><%= relay.team %></td>
                            <td colspan="2"><%= Time.at(relay.time.to_i).utc.strftime('%H:%M:%S') if relay.time %></td>
                            <td><%= relay.category&.category_name || default_category_name %></td>
                        </tr>
                        <% total_time = 0 %>
                        <% (relay.results_id || []).each_with_index do |leg_id, index| %>
                            <% leg = @pdf_legs_by_id[leg_id] %>
                            <% next unless leg %>
                            <% total_time += leg.time.to_i %>
                            <tr>
                                <td>Etapa <%= index + 1 %></td>
                                <td><%= "#{leg.membership&.runner&.runner_name} #{leg.membership&.runner&.surname}" %></td>
                                <td><%= @runner_actual_category_name_by_result_id[leg.id] || default_category_name %></td>
                                <td><%= Time.at(leg.time.to_i).utc.strftime('%H:%M:%S') if leg.time %></td>
                                <td><%= Time.at(total_time).utc.strftime('%H:%M:%S') %></td>
                                <td><%= leg.category&.category_name || default_category_name %></td>
                            </tr>
                        <% end %>
                    <% end %>
                </tbody>
            </table>
            <% if group.rang %>
                <% percent_and_time_data = RelayGroupCategoriesProcessor.new(group).get_percent_and_times %>
                <div class="half">
                    <div>
                        <p>
                            Rang: <%= group.rang %>
                            Clasa:
                            <% clasa_match = group.clasa.to_s[/\d{1,2}/] %>
                            <%= clasa_match ? Category.find(group.clasa.to_i).category_name : group.clasa %>
                        </p>
                    </div>
                    <% if percent_and_time_data.any? %>
                        <br>
                        <table class="table table-striped table-bordered table-hover">
                            <thead class="table-warning">
                                <tr>
                                    <th scope="col">Categoria</th>
                                    <th>Procente</th>
                                    <th>Timpul</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% percent_and_time_data.each do |cat| %>
                                    <tr>
                                        <td><%= cat[:category] %></td>
                                        <td><%= "#{cat[:percent]} %" %></td>
                                        <td><%= cat[:time] %></td>
                                    </tr>
                                <% end %>
                            </tbody>
                        </table>
                    <% end %>
                </div>
            <% end %>
        </div>
    <% else %>
    <% results = group.results.sort_by { |r| r.place.to_i } %>
    <% first_runner = results.first&.runner %>
    <% group_class_name = first_runner&.gender == "M" ? "men" : "women" %>
    <div class="group">
        <header>
            <div class="logo">
                <%= image_tag "#{request.protocol}#{request.host_with_port}#{vite_asset_path('images/logo_fos.png')}",
                                  alt: "Competition Logo",
                                  height: "80" %>
            </div>
            <div class="title-block">
                <h1>
                    <%= @competition.competition_name %>
                </h1>
                <h2>
                    <%= @competition.location %>
                    <%= @competition.date&.strftime("%d/%m/%Y") %>
                </h2>
                <h2>
                    <%= @competition.distance_type %>
                </h2>
            </div>
        </header>
        <h3 class="<%= group_class_name %>">
            <%= group.group_name %>
        </h3>
        <table>
            <thead>
                <tr style="background-color: #90EE90;">
                    <th>Locul</th>
                    <th>Sportiv</th>
                    <th>Club</th>
                    <th>Asociația</th>
                    <th>Anul Nasterii</th>
                    <th>Categoria actuală</th>
                    <th>Timpul</th>
                    <th>Categoria indeplinita</th>
                    <% if @competition.ecn %>
                    <th>ECN Puncte</th>
                    <% end %>
                </tr>
            </thead>
            <tbody>
                <% results.each do |result| %>
                <% place_color = case result.place
                                         when 1 then "#FFDF00"
                                         when 2 then "#D7D7D8"
                                         when 3 then "#CE8946"
                                         end %>
                <% runner = result.runner %>
                <% actual_category_name = @runner_actual_category_name_by_result_id[result.id] || default_category_name %>
                <tr>
                    <td style="background-color: <%= place_color %>;">
                        <%= result.place %>
                    </td>
                    <td>
                        <%= "#{runner&.runner_name} #{runner&.surname}" %>
                    </td>
                    <td>
                        <%= runner.club.club_name %>
                    </td>
                    <td>
                        <%= result.membership.club.club_name %>
                    </td>
                    <td>
                        <%= runner&.yob %>
                    </td>
                    <% if result.status == Result::CAPPED %>
                    <td>
                        <%= actual_category_name %>(
                        <%= result.child_results.first.category.category_name%>*)</td>
                    <% else %>
                    <td>
                        <%= actual_category_name %>
                    </td>
                    <% end %>
                    <td>
                        <%= Time.at(result.time.to_i).utc.strftime('%H:%M:%S') if result.time %>
                    </td>
                    <td>
                        <%= result.category&.category_name %>
                    </td>
                    <% if @competition.ecn %>
                    <td>
                        <%= result.ecn_points %>
                    </td>
                    <% end %>
                </tr>
                <% end %>
            </tbody>
        </table>
        <% if results.any? { |r| r.status == Result::CAPPED } %>
            <p> * Categoria trebuie confirmată la Ministerul Educației și Cercetării al Republicii Moldova
        <% end %>
        <hr>
         <% if group.rang %>
            <% percent_and_time_data = GroupCategoriesProcessor.new(group).get_percent_and_times %>
            <div class="half">
                <div>
                    <p>
                        Rang:
                        <%= group.rang %>
                        Clasa:
                        <% clasa_match = group.clasa.to_s[/\d{1,2}/] %>
                        <%= clasa_match ? Category.find(group.clasa.to_i).category_name : group.clasa %>
                    </p>
                </div>
                <br>
                <table class="table table-striped table-bordered table-hover">
                    <thead class="table-warning">
                        <tr>
                            <th scope="col">Categoria</th>
                            <th>Procente</th>
                            <th>Timpul</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% percent_and_time_data.each do |cat| %>
                        <tr>
                            <td>
                                <%= cat[:category] %>
                            </td>
                            <td>
                                <%= "#{cat[:percent]} %" %>
                            </td>
                            <td>
                                <%= cat[:time] %>
                            </td>
                        </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
            <% end %>
    </div>
    <% end %>
    <% end %>
</div>
