<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title><%= @competition&.competition_name %> — Rezultate</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: "Helvetica Neue", "Inter", system-ui, sans-serif;
      margin: 0;
      background: #fff;
      color: #1c2a1f;
      font-size: 10pt;
    }

    .page {
      padding: 18mm 14mm;
      page-break-after: always;
      break-after: page;
      min-height: 100vh;
    }
    .page:last-of-type {
      page-break-after: auto;
      break-after: auto;
    }

    .hero {
      background: linear-gradient(135deg, #14532d 0%, #1f5f3a 45%, #2d7a4c 100%);
      color: white;
      border-radius: 16px;
      padding: 18mm 14mm 14mm;
      margin-bottom: 8mm;
      position: relative;
      overflow: hidden;
    }
    .hero::after {
      content: "";
      position: absolute;
      top: -30%; right: -10%;
      width: 60%;
      height: 200%;
      background: radial-gradient(circle, rgba(251, 191, 36, 0.18), transparent 60%);
      pointer-events: none;
    }
    .hero .eyebrow {
      text-transform: uppercase;
      font-size: 9pt;
      letter-spacing: 2px;
      color: #fde68a;
      margin-bottom: 4mm;
      font-weight: 600;
    }
    .hero .title {
      font-size: 28pt;
      font-weight: 800;
      line-height: 1.05;
      margin: 0 0 4mm 0;
      max-width: 80%;
    }
    .hero .meta {
      font-size: 11pt;
      opacity: 0.92;
    }
    .hero .meta .dot {
      margin: 0 8px;
      opacity: 0.5;
    }
    .hero .badges {
      margin-top: 5mm;
      display: flex;
      gap: 6px;
    }
    .badge {
      background: rgba(255,255,255,0.18);
      border-radius: 999px;
      padding: 4px 12px;
      font-size: 9pt;
      font-weight: 600;
    }
    .badge.ecn { background: rgba(251, 191, 36, 0.28); color: #fde68a; }

    .group {
      margin-bottom: 10mm;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .group + .group {
      page-break-before: always;
      break-before: page;
    }

    .group-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-left: 5px solid #1f5f3a;
      padding-left: 10px;
      margin-bottom: 5mm;
    }
    .group-head.women { border-left-color: #c2410c; }
    .group-head .name {
      font-size: 18pt;
      font-weight: 800;
      color: #14532d;
      margin: 0;
    }
    .group-head.women .name { color: #c2410c; }
    .group-head .sub {
      font-size: 9pt;
      color: #4f6b54;
    }

    .podium {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      margin-bottom: 5mm;
    }
    .podium-card {
      border-radius: 10px;
      padding: 8px 10px;
      border-top: 3px solid #c2410c;
      background: #f8faf5;
    }
    .podium-card.place-1 { background: linear-gradient(180deg, #fff7ed, #fed7aa); border-top-color: #c2410c; }
    .podium-card.place-2 { background: linear-gradient(180deg, #fafaf9, #e7e5e4); border-top-color: #78716c; }
    .podium-card.place-3 { background: linear-gradient(180deg, #fef3c7, #fde68a); border-top-color: #b45309; }
    .podium-card .medal { font-size: 14pt; }
    .podium-card .who { font-weight: 700; font-size: 10pt; margin-top: 2px; }
    .podium-card .club-line { font-size: 8.5pt; color: #57534e; }
    .podium-card .t { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 10pt; color: #14532d; margin-top: 2px; }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 4mm;
    }
    th {
      background: #f1f5e8;
      color: #2d4a30;
      font-size: 8.5pt;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 6px 8px;
      text-align: left;
      border-bottom: 2px solid #1f5f3a;
    }
    td {
      padding: 6px 8px;
      font-size: 9.5pt;
      border-bottom: 1px solid #eef2eb;
    }
    tr:nth-child(even) td { background: #fbfdf8; }
    td.t, td.place { font-variant-numeric: tabular-nums; }
    td.place {
      font-weight: 800;
      text-align: center;
      width: 36px;
    }
    .place.p1 { color: #c2410c; }
    .place.p2 { color: #78716c; }
    .place.p3 { color: #b45309; }

    .relay-card {
      border: 1px solid #d6e4d8;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 5mm;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .relay-head {
      display: grid;
      grid-template-columns: 40px 1fr auto;
      gap: 10px;
      align-items: center;
      padding: 8px 12px;
      background: linear-gradient(135deg, #f1f5e8, #e1ecd0);
      border-bottom: 1px solid #d6e4d8;
    }
    .relay-head .pl {
      font-size: 16pt;
      font-weight: 800;
      text-align: center;
      color: #14532d;
    }
    .relay-head .team { font-weight: 700; color: #14532d; font-size: 11pt; }
    .relay-head .meta { font-size: 8.5pt; color: #4f6b54; }
    .relay-head .total { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 11pt; color: #14532d; }
    .relay-card table { margin-bottom: 0; }
    .relay-card th { background: #f8faf5; border-bottom: 1px solid #d6e4d8; }

    .stats {
      background: #f1f5e8;
      border-radius: 10px;
      padding: 4mm 5mm;
      margin-top: 4mm;
    }
    .stats .title {
      font-weight: 700;
      color: #14532d;
      margin-bottom: 2mm;
      font-size: 10pt;
    }
    .stats-line {
      display: flex;
      justify-content: space-between;
      font-size: 9pt;
      color: #4f6b54;
      margin-bottom: 2mm;
    }
    .stats table th, .stats table td {
      background: white;
      font-size: 9pt;
    }

    .footnote { font-size: 8pt; color: #4f6b54; margin-top: 2mm; font-style: italic; }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>
