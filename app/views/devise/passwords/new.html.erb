<div class="auth-page">
  <div class="auth-card">
    <h2 class="auth-title">Recuperare parolă</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-field last">
        <%= f.label :email, "Email", class: "auth-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input" %>
      </div>

      <%= f.submit "Trimite instrucțiuni", class: "auth-submit" %>
    <% end %>

    <div class="auth-footer">
      <%= link_to "Înapoi la autentificare", new_session_path(resource_name), class: "auth-link" %>
    </div>
  </div>
</div>
