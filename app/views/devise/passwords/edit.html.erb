<div class="auth-page">
  <div class="auth-card">
    <h2 class="auth-title">Schimbă parola</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="auth-field">
        <%= f.label :password, "Parolă nouă", class: "auth-label" %>
        <% if @minimum_password_length %>
          <p class="auth-hint">(minim <%= @minimum_password_length %> caractere)</p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "auth-input" %>
      </div>

      <div class="auth-field last">
        <%= f.label :password_confirmation, "Confirmă parola", class: "auth-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input" %>
      </div>

      <%= f.submit "Schimbă parola", class: "auth-submit" %>
    <% end %>

    <div class="auth-footer">
      <%= link_to "Înapoi la autentificare", new_session_path(resource_name), class: "auth-link" %>
    </div>
  </div>
</div>
